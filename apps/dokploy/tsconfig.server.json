{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"module": "ESNext",
		"outDir": "dist/",
		"target": "ESNext",
		"isolatedModules": false,
		"noEmit": false,
		"moduleResolution": "Node",
		"baseUrl": ".",
		"paths": {
			"@/*": ["./*"],
			"@dokploy/server": ["../../packages/server/src/index.ts"],
			"@dokploy/server/*": ["../../packages/server/src/*"]
		}
	},
	"include": [
		"next-env.d.ts",
		"./server/**/*",
		"./setup.ts",
		"./migration.ts",
		"./wait-for-postgres.ts",
		"./reset-password.ts",
		"./reset-2fa.ts",
		"./esbuild.config.ts"
	]
}
